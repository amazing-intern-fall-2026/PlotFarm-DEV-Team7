# ==============================================================================
# FRONTEND CLIENT ENVIRONMENT (.env.example)
# Đặt tại: apps/client/.env
# Lưu ý: Mọi biến dùng trong code React Vite đều phải có tiền tố VITE_
# ==============================================================================

# URL kết nối tới Backend API Express
VITE_API_URL="http://localhost:5000/api"

# Tên ứng dụng & Ký hiệu tiền tệ
VITE_APP_NAME="PlotFarm - Nông Trại Thông Minh"
VITE_CURRENCY_SYMBOL="đ"

# Demo HLS Stream Video (Camera trực tiếp luống đất không cần lắp cam thật)
VITE_MOCK_STREAM_URL="https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8"

# Cloudinary Upload (cho Farmer upload ảnh chụp cây thực tế)
VITE_CLOUDINARY_CLOUD_NAME="your_cloud_name"
VITE_CLOUDINARY_UPLOAD_PRESET="plotfarm_farming_logs"

# Template đường dẫn tra cứu khi scan Barcode / QR trên phiếu gửi hàng A6
VITE_TRACKING_URL_TEMPLATE="http://localhost:5173/shipments/"
