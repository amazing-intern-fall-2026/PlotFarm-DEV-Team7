cable payment_orders {
  id uuid [pk]
  order_code varchar(100) [unique, not null] // PAY-PF2026-0915-A01
  contract_id uuid [not null]
  user_id uuid [not null]
  
  amount numeric(14,2) [not null]
  payment_method payment_method [not null]
  payment_type payment_type [not null, default: 'CONTRACT_INITIAL']
  status transaction_status [not null, default: 'PENDING']

  qr_content text
  qr_image_url text
  expires_at timestamptz [not null]
  paid_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    order_code
    contract_id
    user_id
    status
  }
}

Table payment_transactions {
  id uuid [pk]
  payment_order_id uuid [not null]
  
  gateway_reference varchar(150) [not null] // MB_FT2625391823901
  sender_bank_code varchar(30)
  sender_account_no varchar(100)
  sender_account_name varchar(150)
  
  transfer_amount numeric(14,2) [not null]
  transfer_content text
  
  raw_webhook_payload jsonb [not null]
  idempotency_key varchar(120) [unique, not null]

  received_at timestamptz [not null, default: `now()`]

  indexes {
    payment_order_id
    gateway_reference
    sender_account_no
    idempotency_key
  }
}

Table compensations {
  id uuid [pk]
  compensation_code varchar(60) [unique, not null] // CMP-2026-0015
  
  contract_id uuid [not null]
  payment_order_id uuid
  requested_by_user_id uuid [not null]
  approved_by_user_id uuid
  
  reason_category compensation_reason [not null]
  reason_detail text [not null]
  damage_evidence_urls jsonb
  
  payout_type compensation_payout_type [not null]
  amount numeric(14,2) [not null]
  
  beneficiary_bank_code varchar(30)
  beneficiary_account_no varchar(100)
  beneficiary_account_name varchar(150)

  status compensation_status [not null, default: 'REQUESTED']
  admin_notes text
  
  payout_reference varchar(150)
  payout_completed_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    compensation_code
    contract_id
    status
    requested_by_user_id
  }
}

// ==============================================================================
// 6. NHẬT KÝ NÔNG VỤ BẤT BIẾN (IMMUTABLE LOGS) & PHẢN BIỆN CỦA KHÁCH
// ==============================================================================

Table farming_logs {
  id uuid [pk]
  log_code varchar(60) [unique, not null] // LOG-2026-0035
  contract_id uuid [not null]
  staff_id uuid [not null]

  stage_name_i18n jsonb [not null]
  action_type varchar(50) [not null]
  notes text
  image_urls jsonb
  
  temperature numeric(5,2)
  humidity numeric(5,2)
  soil_moisture numeric(5,2)

  replaces_log_id uuid
  amendment_reason text

  logged_at timestamptz [not null, default: `now()`]

  indexes {
    log_code
    contract_id
    staff_id
    logged_at
  }
}

Table farming_log_reviews {
  id uuid [pk]
  farming_log_id uuid [not null]
  customer_id uuid [not null]
  
  rating integer
  customer_feedback text
  is_flagged_abnormal boolean [not null, default: false]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    farming_log_id
    customer_id
  }
}

Table care_requests {
  id uuid [pk]
  request_code varchar(60) [unique, not null] // REQ-2026-0089
  contract_id uuid [not null]
  staff_id uuid
  
  service_type care_service_type [not null]
  service_title_i18n jsonb [not null]
  customer_note text
  staff_response text
  proof_images jsonb
  
  extra_fee numeric(14,2) [not null, default: 0]
  is_fee_paid boolean [not null, default: true]

  status care_request_status [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    request_code
    contract_id
    status
    staff_id
  }
}

Table harvests {
  id uuid [pk]
  harvest_code varchar(60) [unique, not null] // HVT-2026-0042
  contract_id uuid [unique, not null]
  staff_id uuid [not null]

  harvest_date date [not null]
  actual_yield_kg numeric(14,3) [not null]
  quality_grade varchar(20) [default: 'GRADE_A']
  proof_photos jsonb
  notes text

  created_at timestamptz [not null, default: `now()`]

  indexes {
    harvest_code
    contract_id
    staff_id
  }
}

Table shipments {
  id uuid [pk]
  contract_id uuid [unique, not null]
  tracking_code varchar(80) [unique, not null] // GHN-PF2026-881923
  carrier_code varchar(50) [not null]
  
  sender_address text [not null]
  receiver_name varchar(150) [not null]
  receiver_phone varchar(30) [not null]
  receiver_address text [not null]
  
  total_weight_kg numeric(10,3) [not null]
  shipping_fee numeric(14,2) [not null, default: 0]
  
  current_status shipment_status [not null, default: 'PREPARING']
  estimated_delivery_at timestamptz
  delivered_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    tracking_code
    current_status
  }
}

// ==============================================================================
// 7. AUDIT LOGS HỆ THỐNG
// ==============================================================================

Table audit_logs {
  id uuid [pk]
  audit_code varchar(60) [unique, not null] // AUD-2026-0182
  actor_id uuid
  action varchar(100) [not null]
  entity_table varchar(60) [not null]
  entity_id uuid [not null]
  
  old_state jsonb
  new_state jsonb
  ip_address varchar(50)
  user_agent text
  
  created_at timestamptz [not null, default: `now()`]

  indexes {
    audit_code
    (entity_table, entity_id)
    actor_id
    action
    created_at
  }
}

// ==============================================================================
// RELATIONSHIPS
// ==============================================================================

Ref: user_bank_accounts.user_id > users.id
Ref: farms.manager_id > users.id

Ref: plots.farm_id > farms.id
Ref: plots.default_crop_id > crops.id
Ref: plots.assigned_staff_id > users.id
Ref: plots.locked_by_user_id > users.id

Ref: contracts.user_id > users.id
Ref: contracts.plot_id > plots.id
Ref: contracts.crop_id > crops.id
Ref: contracts.voucher_id > vouchers.id

Ref: contract_extra_fees.contract_id > contracts.id

Ref: payment_orders.contract_id > contracts.id
Ref: payment_orders.user_id > users.id
Ref: payment_transactions.payment_order_id > payment_orders.id

Ref: compensations.contract_id > contracts.id
Ref: compensations.payment_order_id > payment_orders.id
Ref: compensations.requested_by_user_id > users.id
Ref: compensations.approved_by_user_id > users.id

Ref: farming_logs.contract_id > contracts.id
Ref: farming_logs.staff_id > users.id
Ref: farming_logs.replaces_log_id - farming_logs.id

Ref: farming_log_reviews.farming_log_id > farming_logs.id
Ref: farming_log_reviews.customer_id > users.id

Ref: care_requests.contract_id > contracts.id
Ref: care_requests.staff_id > users.id

Ref: harvests.contract_id > contracts.id
Ref: harvests.staff_id > users.id

Ref: shipments.contract_id > contracts.id
Ref: audit_logs.actor_id > users.id
