// ==============================================================================
// PLOTFARM DATABASE DEFINITION (DBML v2.0 - ENTERPRISE EDITION)
// Hỗ trợ: Đối soát đền bù, Đa ngôn ngữ (i18n), Nhật ký bất biến chống gian lận,
// Phân quyền 3 Role (Customer, Staff, Admin) & Tối ưu UI Frontend
// ==============================================================================

// ==============================================================================
// 1. ENUMS
// ==============================================================================

Enum user_role {
  CUSTOMER
  STAFF
  ADMIN
}

Enum plot_status {
  AVAILABLE
  RESERVED
  OCCUPIED
  HARVESTING
  MAINTENANCE
  INACTIVE
}

Enum contract_status {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  IN_HARVEST
  COMPLETED
  CANCELLED
  DISPUTED
}

Enum payment_method {
  VIETQR
  VNPAY
  MOMO
  BANK_TRANSFER
  CASH
}

Enum payment_type {
  CONTRACT_INITIAL
  EXTRA_SERVICE
  RENEWAL
}

Enum transaction_status {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

Enum compensation_reason {
  CROP_DISEASE_OUTBREAK    // Dịch bệnh hại cây
  SEVERE_WEATHER_LOSS      // Thiên tai bão lũ
  STAFF_CARE_NEGLECT       // Lỗi do kỹ thuật viên chăm sóc
  SYSTEM_CANCELLATION      // Hủy từ phía ban quản trị farm
  QUALITY_BELOW_STANDARD   // Năng suất không đạt cam kết tối thiểu
}

Enum compensation_status {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

Enum compensation_payout_type {
  BANK_REFUND         // Chuyển trả tiền về tài khoản ngân hàng
  WALLET_CREDIT       // Cộng số dư ví nội bộ
  FREE_REPLANT_PLOT   // Cấp lượt gieo trồng bù một vụ mới tương đương
  VOUCHER_CODE        // Đền bù bằng mã giảm giá
}

Enum care_service_type {
  ORGANIC_FERTILIZER
  WEEDING_PEST_CONTROL
  PRUNING
  IRRIGATION_CHECK
  SPECIAL_NUTRITION
}

Enum care_request_status {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

Enum shipment_status {
  PREPARING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
}

Enum voucher_discount_type {
  PERCENTAGE
  FIXED_AMOUNT
}

Enum voucher_status {
  ACTIVE
  INACTIVE
  EXPIRED
}

// ==============================================================================
// 2. USERS, AUTHENTICATION & SỔ TÀI KHOẢN NGÂN HÀNG
// ==============================================================================

Table users {
  id uuid [pk]
  email varchar(320) [unique, not null]
  phone varchar(30) [unique]
  password_hash varchar(255) [not null]
  full_name varchar(150) [not null]
  avatar_url text
  role user_role [not null, default: 'CUSTOMER']
  is_verified boolean [not null, default: false]
  preferred_locale varchar(10) [not null, default: 'vi']
  
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    email
    phone
    role
  }
}

Table user_bank_accounts {
  id uuid [pk]
  user_id uuid [not null]
  bank_code varchar(20) [not null]
  bank_name varchar(100) [not null]
  account_number varchar(50) [not null]
  account_holder_name varchar(150) [not null]
  is_default boolean [not null, default: false]
  is_verified boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    (user_id, is_default)
  }
}

// ==============================================================================
// 3. MASTER DATA & LOCALIZATION (i18n JSONB)
// ==============================================================================

Table farms {
  id uuid [pk]
  slug varchar(150) [unique, not null]
  name_i18n jsonb [not null]
  address_i18n jsonb [not null]
  latitude numeric(10,7)
  longitude numeric(10,7)
  total_area_sqm numeric(12,2) [not null]
  contact_phone varchar(30)
  manager_id uuid

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table crops {
  id uuid [pk]
  slug varchar(150) [unique, not null]
  
  name_i18n jsonb [not null]
  description_i18n jsonb
  guide_i18n jsonb

  duration_days integer [not null]
  ideal_temp_min numeric(5,2)
  ideal_temp_max numeric(5,2)
  ideal_moisture_min numeric(5,2)
  ideal_moisture_max numeric(5,2)
  expected_yield_kg_per_sqm numeric(8,2) [not null, default: 1.5]

  base_price numeric(14,2) [not null, default: 0]
  icon_url text
  cover_image_url text
  is_active boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    slug
    is_active
  }
}

Table plots {
  id uuid [pk]
  farm_id uuid [not null]
  default_crop_id uuid
  assigned_staff_id uuid

  plot_number varchar(50) [not null]
  area_sqm numeric(10,2) [not null]
  soil_type_i18n jsonb
  price_per_month numeric(14,2) [not null, default: 0]
  status plot_status [not null, default: 'AVAILABLE']

  stream_url text
  camera_credentials_vault_id text
  
  locked_by_user_id uuid
  locked_until timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    farm_id
    status
    assigned_staff_id
    locked_until
  }
}

Table vouchers {
  id uuid [pk]
  code varchar(50) [unique, not null]
  discount_type voucher_discount_type [not null]
  discount_value numeric(14,2) [not null]
  max_discount numeric(14,2)
  min_order_amount numeric(14,2)
  usage_limit integer
  used_count integer [not null, default: 0]
  start_at timestamptz [not null]
  end_at timestamptz [not null]
  status voucher_status [not null, default: 'ACTIVE']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    code
    status
    start_at
    end_at
  }
}

// ==============================================================================
// 4. CONTRACTS & NÔNG NGHIỆP TRẢI NGHIỆM
// ==============================================================================

Table contracts {
  id uuid [pk]
  contract_code varchar(50) [unique, not null]

  user_id uuid [not null]
  plot_id uuid [not null]
  crop_id uuid [not null]
  voucher_id uuid

  start_date date [not null]
  expected_harvest_date date [not null]
  actual_harvest_date date

  crop_price_snapshot numeric(14,2) [not null]
  plot_price_snapshot numeric(14,2) [not null]
  subtotal numeric(14,2) [not null]
  discount_amount numeric(14,2) [not null, default: 0]
  extra_fee numeric(14,2) [not null, default: 0]
  total_price numeric(14,2) [not null]

  status contract_status [not null, default: 'PENDING_PAYMENT']
  progress_percent integer [not null, default: 0]
  health_score integer [default: 100]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    plot_id
    status
    contract_code
  }
}

Table contract_extra_fees {
  id uuid [pk]
  contract_id uuid [not null]
  fee_name_i18n jsonb [not null]
  amount numeric(14,2) [not null]
  description text
  is_paid boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    contract_id
  }
}

// ==============================================================================
// 5. THANH TOÁN, ĐỐI SOÁT CHUYỂN KHOẢN & HỆ THỐNG ĐỀN BÙ
// ==============================================================================

Table payment_orders {
  id uuid [pk]
  order_code varchar(100) [unique, not null]
  contract_id uuid [not null]
  user_id uuid [not null]
  
  amount numeric(14,2) [not null]
  payment_method payment_method [not null]
  payment_type payment_type [not null, default: 'CONTRACT_INITIAL']
  status transaction_status [not null, default: 'PENDING']

  qr_content text
  qr_image_url text
  expires_at timestamptz [not null]
  paid_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    order_code
    contract_id
    user_id
    status
  }
}

Table payment_transactions {
  id uuid [pk]
  payment_order_id uuid [not null]
  
  gateway_reference varchar(150) [not null]
  sender_bank_code varchar(30)
  sender_account_no varchar(100)
  sender_account_name varchar(150)
  
  transfer_amount numeric(14,2) [not null]
  transfer_content text
  
  raw_webhook_payload jsonb [not null]
  idempotency_key varchar(120) [unique, not null]

  received_at timestamptz [not null, default: `now()`]

  indexes {
    payment_order_id
    gateway_reference
    sender_account_no
    idempotency_key
  }
}

Table compensations {
  id uuid [pk]
  compensation_code varchar(60) [unique, not null]
  
  contract_id uuid [not null]
  payment_order_id uuid
  requested_by_user_id uuid [not null]
  approved_by_user_id uuid
  
  reason_category compensation_reason [not null]
  reason_detail text [not null]
  damage_evidence_urls jsonb
  
  payout_type compensation_payout_type [not null]
  amount numeric(14,2) [not null]
  
  beneficiary_bank_code varchar(30)
  beneficiary_account_no varchar(100)
  beneficiary_account_name varchar(150)

  status compensation_status [not null, default: 'REQUESTED']
  admin_notes text
  
  payout_reference varchar(150)
  payout_completed_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    contract_id
    status
    compensation_code
    requested_by_user_id
  }
}

// ==============================================================================
// 6. NHẬT KÝ NÔNG VỤ BẤT BIẾN (IMMUTABLE LOGS) & PHẢN BIỆN CỦA KHÁCH
// ==============================================================================

Table farming_logs {
  id uuid [pk]
  contract_id uuid [not null]
  staff_id uuid [not null]

  stage_name_i18n jsonb [not null]
  action_type varchar(50) [not null]
  notes text
  image_urls jsonb
  
  temperature numeric(5,2)
  humidity numeric(5,2)
  soil_moisture numeric(5,2)

  replaces_log_id uuid
  amendment_reason text

  logged_at timestamptz [not null, default: `now()`]

  indexes {
    contract_id
    staff_id
    logged_at
  }
}

Table farming_log_reviews {
  id uuid [pk]
  farming_log_id uuid [not null]
  customer_id uuid [not null]
  
  rating integer
  customer_feedback text
  is_flagged_abnormal boolean [not null, default: false]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    farming_log_id
    customer_id
  }
}

Table care_requests {
  id uuid [pk]
  contract_id uuid [not null]
  staff_id uuid
  
  service_type care_service_type [not null]
  service_title_i18n jsonb [not null]
  customer_note text
  staff_response text
  proof_images jsonb
  
  extra_fee numeric(14,2) [not null, default: 0]
  is_fee_paid boolean [not null, default: true]

  status care_request_status [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    contract_id
    status
    staff_id
  }
}

Table harvests {
  id uuid [pk]
  contract_id uuid [unique, not null]
  staff_id uuid [not null]

  harvest_date date [not null]
  actual_yield_kg numeric(14,3) [not null]
  quality_grade varchar(20) [default: 'GRADE_A']
  proof_photos jsonb
  notes text

  created_at timestamptz [not null, default: `now()`]

  indexes {
    contract_id
    staff_id
  }
}

Table shipments {
  id uuid [pk]
  contract_id uuid [unique, not null]
  tracking_code varchar(80) [unique, not null]
  carrier_code varchar(50) [not null]
  
  sender_address text [not null]
  receiver_name varchar(150) [not null]
  receiver_phone varchar(30) [not null]
  receiver_address text [not null]
  
  total_weight_kg numeric(10,3) [not null]
  shipping_fee numeric(14,2) [not null, default: 0]
  
  current_status shipment_status [not null, default: 'PREPARING']
  estimated_delivery_at timestamptz
  delivered_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    tracking_code
    current_status
  }
}

// ==============================================================================
// 7. AUDIT LOGS HỆ THỐNG
// ==============================================================================

Table audit_logs {
  id uuid [pk]
  actor_id uuid
  action varchar(100) [not null]
  entity_table varchar(60) [not null]
  entity_id uuid [not null]
  
  old_state jsonb
  new_state jsonb
  ip_address varchar(50)
  user_agent text
  
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_table, entity_id)
    actor_id
    action
    created_at
  }
}

// ==============================================================================
// RELATIONSHIPS
// ==============================================================================

Ref: user_bank_accounts.user_id > users.id
Ref: farms.manager_id > users.id

Ref: plots.farm_id > farms.id
Ref: plots.default_crop_id > crops.id
Ref: plots.assigned_staff_id > users.id
Ref: plots.locked_by_user_id > users.id

Ref: contracts.user_id > users.id
Ref: contracts.plot_id > plots.id
Ref: contracts.crop_id > crops.id
Ref: contracts.voucher_id > vouchers.id

Ref: contract_extra_fees.contract_id > contracts.id

Ref: payment_orders.contract_id > contracts.id
Ref: payment_orders.user_id > users.id
Ref: payment_transactions.payment_order_id > payment_orders.id

Ref: compensations.contract_id > contracts.id
Ref: compensations.payment_order_id > payment_orders.id
Ref: compensations.requested_by_user_id > users.id
Ref: compensations.approved_by_user_id > users.id

Ref: farming_logs.contract_id > contracts.id
Ref: farming_logs.staff_id > users.id
Ref: farming_logs.replaces_log_id - farming_logs.id

Ref: farming_log_reviews.farming_log_id > farming_logs.id
Ref: farming_log_reviews.customer_id > users.id

Ref: care_requests.contract_id > contracts.id
Ref: care_requests.staff_id > users.id

Ref: harvests.contract_id > contracts.id
Ref: harvests.staff_id > users.id

Ref: shipments.contract_id > contracts.id
Ref: audit_logs.actor_id > users.id
