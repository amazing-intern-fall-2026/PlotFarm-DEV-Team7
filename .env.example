# ==============================================================================
# PLOTFARM (BIO-CLOUD FARMING) — FULL STACK ENVIRONMENT CONFIGURATION (.env.example)
#
# HƯỚNG DẪN THAO TÁC NHANH DÀNH CHO CẢ NHÓM (FE & BE):
# 1. Tạo file .env từ file này bằng lệnh:
#    PowerShell:  Copy-Item .env.example .env
#    Bash/Linux:  cp .env.example .env
# 2. Đăng ký tài khoản tại các đường link bên dưới và dán key tương ứng.
# 3. Chạy lệnh đồng bộ Database lên Cloud:
#    pnpm --filter @repo/database db:push
# 4. Chạy toàn bộ hệ thống Monorepo:
#    pnpm dev
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLOUD DATABASE (PostgreSQL qua Prisma ORM)
# ------------------------------------------------------------------------------
# Link thao tác tạo DB miễn phí (30 giây xong):
# ➔ https://neon.tech  (Khuyên dùng số 1: Miễn phí, cực nhanh, chọn Region: Singapore)
# ➔ Hoặc: https://supabase.com
#
# Cách lấy chuỗi:
# - Sau khi tạo Project "plotfarm-dev" trên Neon.tech, copy chuỗi "Connection String" (chọn thẻ Prisma hoặc PostgreSQL)
# - Lưu ý: Luôn có đuôi ?sslmode=require khi kết nối Cloud DB
DATABASE_URL="postgresql://neondb_owner:your_neon_password@ep-cool-fog-123456.ap-southeast-1.neon.tech/plotfarm_dev?sslmode=require"

# ------------------------------------------------------------------------------
# 2. BACKEND API SERVER (apps/server)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173,http://localhost:6006"

# JWT Authentication (Cấp Access Token 15 phút, Refresh Token 7 ngày)
JWT_SECRET="plotfarm_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="plotfarm_refresh_super_secret_jwt_key_2026"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 3. FRONTEND CLIENT (apps/client - Bắt buộc tiền tố VITE_)
# ------------------------------------------------------------------------------
VITE_API_URL="http://localhost:5000/api"
VITE_APP_NAME="PlotFarm - Nông Trại Thông Minh"
VITE_CURRENCY_SYMBOL="đ"

# Demo HLS Stream Video (Camera trực tiếp luống đất không cần lắp camera thật)
# Link test m3u8 chạy 24/7 mượt mà từ Mux: https://test-streams.mux.dev/
VITE_MOCK_STREAM_URL="https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8"

# ------------------------------------------------------------------------------
# 4. XÁC THỰC EMAIL (VERIFY EMAIL & RESET PASSWORD)
# ------------------------------------------------------------------------------
# Link thao tác đăng ký lấy API Key miễn phí (3.000 mail/tháng):
# ➔ https://resend.com
#
# Cách lấy:
# 1. Đăng ký Resend bằng tài khoản GitHub
# 2. Vào mục "API Keys" ➔ Bấm "Create API Key"
# 3. Trong chế độ dev chưa có tên miền riêng, dùng email gửi là: "onboarding@resend.dev"
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
EMAIL_FROM="PlotFarm <onboarding@resend.dev>"
EMAIL_VERIFY_REDIRECT_URL="http://localhost:5173/auth/verify-email"

# (Tùy chọn thay thế: Nếu muốn dùng Gmail SMTP miễn phí):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-character-google-app-password"

# ------------------------------------------------------------------------------
# 5. CỔNG THANH TOÁN QR CODE (VIETQR NAPAS & VNPAY)
# ------------------------------------------------------------------------------
# === PHƯƠNG ÁN A: VietQR Napas 24/7 (Khuyên dùng theo SRS - Không cần giấy phép KD) ===
# Tài liệu API mở: https://vietqr.io/
VIETQR_BANK_ID="970422"                 # Mã BIN ngân hàng (970422 là MBBank, 970436 là VCB)
VIETQR_BANK_NAME="MB Bank"
VIETQR_ACCOUNT_NO="0987654321"
VIETQR_ACCOUNT_NAME="CTY CP CONG NGHE PLOTFARM"
VIETQR_TEMPLATE="compact2"              # Giao diện mã QR: compact, compact2, qr_only

# === PHƯƠNG ÁN B: VNPay Sandbox (Tùy chọn nếu đề tài bắt buộc VNPay) ===
# Link thao tác đăng ký tài khoản Sandbox:
# ➔ https://sandbox.vnpayment.vn/devreg/
VNP_TMN_CODE="YOUR_VNPAY_TMN_CODE"
VNP_HASH_SECRET="YOUR_VNPAY_HASH_SECRET"
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_RETURN_URL="http://localhost:5173/checkout/vnpay-return"

# ------------------------------------------------------------------------------
# 6. LƯU TRỮ ẢNH NHẬT KÝ CANH TÁC & NGHIỆM THU (CLOUDINARY)
# ------------------------------------------------------------------------------
# Link thao tác đăng ký miễn phí (25GB lưu trữ ảnh):
# ➔ https://cloudinary.com
#
# Cách lấy:
# 1. Đăng ký Cloudinary ➔ Vào Dashboard lấy "Cloud name", "API Key", "API Secret"
# 2. Vào Settings ➔ Upload ➔ Thêm 1 "Upload preset" chế độ "Unsigned" đặt tên là "plotfarm_farming_logs"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
VITE_CLOUDINARY_CLOUD_NAME="your_cloud_name"
VITE_CLOUDINARY_UPLOAD_PRESET="plotfarm_farming_logs"

# ------------------------------------------------------------------------------
# 7. VẬN CHUYỂN, BARCODE CODE128 & SCAN MÃ ĐƠN HÀNG (LOGISTICS)
# ------------------------------------------------------------------------------
LOGISTICS_CARRIER_NAME="AgriExpress Logistics"
LOGISTICS_TRACKING_PREFIX="AGRI-VN-"
# Cú pháp link tra cứu khi scan mã QR trên phiếu in A6:
VITE_TRACKING_URL_TEMPLATE="http://localhost:5173/shipments/"
